  "material": {
    "scope": {"$type": "string", "$value": "Regular Glass only for navigation, important toolbar groups, and temporary overlays; Standard for content, charts, cards, logs, and specimen frames"},
    "parameter-origin": {"$type": "string", "$value": "Prism Web parameters requested by the user; not fixed values published by Apple"},
    "regular": {"$type": "string", "$value": "Default functional material; adapt luminosity and opacity for readable labels; share one shell per tool group"},
    "clear": {"$type": "string", "$value": "Media-overlay controls and optical experiments only; assess a 35% black dimming layer over bright media"},
    "standard": {"$type": "string", "$value": "Opaque pearl gradient, inset highlight and soft shadow; no background blur, refraction, pointer reflection or card tilt"},
    "grouping": {"$type": "string", "$value": "Group related toolbar actions in one material; do not repeat blur on child buttons or stack glass shells"},
    "concentric-radius": {"$type": "string", "$value": "Derive inner radius from outer radius minus inset; use a suitable minimum for control size"},
    "scroll-edge": {"$type": "string", "$value": "Use a soft content fade beneath fixed navigation; keep focused controls fully visible"},
    "blur": {"$type": "dimension", "$value": "10px"},
    "saturate": {"$type": "number", "$value": 2.1},
    "radius": {"$type": "dimension", "$value": "30px"},
    "rim": {"$type": "dimension", "$value": "1px"},
    "arc-width": {"$type": "string", "$value": "72%"},
    "arc-height": {"$type": "dimension", "$value": "18px"},
    "arc-top": {"$type": "dimension", "$value": "0px"},
    "backdrop-filter": {"$type": "string", "$value": "blur(10px) saturate(210%)"},
    "rim-gradient": {"$type": "string", "$value": "linear-gradient(120deg, rgba(104,173,255,.5), rgba(192,142,244,.30), rgba(255,157,180,.34), rgba(255,208,146,.45), rgba(136,226,220,.38))"},
    "shadow-light": {"$type": "string", "$value": "inset 0 1px 1px rgba(255,255,255,.95), 0 20px 52px -28px rgba(34,57,102,.30), 0 6px 16px -10px rgba(34,57,102,.16)"},
    "shadow-dark": {"$type": "string", "$value": "inset 0 1px 1px rgba(255,255,255,.26), 0 20px 52px -28px rgba(0,0,0,.65), 0 6px 16px -10px rgba(0,0,0,.5)"},
    "lens-radius": {"$type": "dimension", "$value": "14px"},
    "hover-lift-max": {"$type": "dimension", "$value": "0px"},
    "hover-tilt-max": {"$type": "string", "$value": "0deg"},
    "pointer-reflection": {"$type": "string", "$value": "Important functional shells and optical lens only; track during fine-pointer hover; stop on leave, hidden document, or removed node"},
    "directional-rim": {"$type": "string", "$value": "Important functional shells only; independent subtle masked 1px layer; pointer atan2 angle; static when idle"},
    "optical-scope": {"$type": "string", "$value": "The following optical presets apply only to the local image experiment, not business content or cards"},
