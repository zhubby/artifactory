# [INPUT]: 依赖Runner、Publisher 和 BuildKit buildctl。
# [OUTPUT]: 交付镜像构建与发布工作镜像。
# [POS]: BuildKit daemon 使用独立 sidecar 镜像。
# [PROTOCOL]: Update this header on change, then check AGENTS.md
ARG RUST_IMAGE=rust:1.95-bookworm
ARG BASE_IMAGE=debian:bookworm-slim
ARG BUILDKIT_IMAGE=moby/buildkit:v0.26.2-rootless
FROM ${RUST_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY crates ./crates
COPY operators ./operators
COPY proto ./proto
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/build/target cargo build --locked --release -p artifactory-image-operator --bin artifactory-image-runner --bin artifactory-image-publisher && cp target/release/artifactory-image-runner target/release/artifactory-image-publisher /usr/local/bin/
FROM ${BUILDKIT_IMAGE} AS buildkit
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git git-lfs openssh-client && rm -rf /var/lib/apt/lists/* && useradd --uid 1000 --create-home artifactory
COPY --from=builder /usr/local/bin/artifactory-image-runner /usr/local/bin/artifactory-image-runner
COPY --from=builder /usr/local/bin/artifactory-image-publisher /usr/local/bin/artifactory-image-publisher
COPY --from=buildkit /usr/bin/buildctl /usr/local/bin/buildctl
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/artifactory-image-runner"]
